APP_NAME="گروه ساختمانی طهورنیان"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://tahournian.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tahournian
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=tahournian

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@tahournian.ir"
MAIL_FROM_NAME="${APP_NAME}"

# اطلاعات ورود مدیر اولیه (هنگام اجرای seeder)
ADMIN_NAME="مدیر سایت"
ADMIN_EMAIL=admin@tahournian.ir
ADMIN_PASSWORD=Tahournian@1405
